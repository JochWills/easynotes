# Public URL of the site (no trailing slash). On Render: https://easynotes.onrender.com or https://easynotes.co.za
BASE_URL=http://localhost:3000

# Long random string. Render can generate this for you.
SESSION_SECRET=change-me-to-a-long-random-string

# Supabase > Project settings > API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Paystack > Settings > API Keys & Webhooks (use sk_test_ while testing)
PAYSTACK_SECRET_KEY=sk_test_xxx

# Percentage EasyNotes keeps from every sale
PLATFORM_FEE_PERCENT=15

# Who pays Paystack's transaction fee: "account" (EasyNotes pays it out of its cut) or "subaccount" (deducted from the seller's share)
PAYSTACK_FEE_BEARER=account

# How many times a buyer can download one purchase
MAX_DOWNLOADS=10

SUPPORT_EMAIL=support@easynotes.co.za

# Optional: emails buyers a link to all their notes (resend.com > API Keys). Leave blank to send no emails.
RESEND_API_KEY=
# Must be an address on a domain you've verified in Resend
MAIL_FROM=EasyNotes <noreply@easynotes.co.za>
