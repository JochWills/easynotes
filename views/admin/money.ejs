<%- include('../partials/admin-top', { sub: 'Paystack splits every payment and pays sellers directly, so there’s nothing to pay out by hand. Paystack’s own fee is ' + feeBearerText + '.' }) %>

<div class="kpis">
  <div class="kpi"><span>EasyNotes revenue</span><b><%= rand(all.fees) %></b><small>All time</small></div>
  <div class="kpi"><span>Gross sales</span><b><%= rand(all.gross) %></b><small>All time</small></div>
  <div class="kpi"><span>Paid to sellers</span><b><%= rand(all.payouts) %></b><small>All time</small></div>
  <div class="kpi"><span>Paid orders</span><b><%= all.sales %></b><small>All time</small></div>
</div>

<section class="admin-block" aria-labelledby="month-h">
  <h2 class="admin-h2" id="month-h">By month</h2>
  <div class="table-wrap">
    <table class="data money-months">
      <thead><tr><th>Month</th><th class="num">Orders</th><th>Gross</th><th class="num">EasyNotes</th><th class="num">Sellers</th></tr></thead>
      <tbody>
        <% months.forEach(function (m) { %>
          <tr>
            <td><%= m.label %></td>
            <td class="num"><%= m.sales %></td>
            <td><span class="bar-cell"><span class="bar-num"><%= rand(m.gross) %></span><span class="bar-track" aria-hidden="true"><span class="bar" style="width:<%= Math.round(m.gross / best * 100) %>%"></span></span></span></td>
            <td class="num"><%= rand(m.fees) %></td>
            <td class="num"><%= rand(m.payouts) %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>

<section class="admin-block" aria-labelledby="by-seller-h">
  <h2 class="admin-h2" id="by-seller-h">By seller</h2>
  <% if (sellers.length) { %>
    <div class="table-wrap">
      <table class="data">
        <thead><tr><th>Seller</th><th class="num">Orders</th><th class="num">Gross</th><th class="num">EasyNotes</th><th class="num">Seller earned</th><th>Last sale</th></tr></thead>
        <tbody>
          <% sellers.forEach(function (s) { %><tr><td><a href="/admin/sellers/<%= s.id %>"><%= s.name %></a></td><td class="num"><%= s.sales %></td><td class="num"><%= rand(s.gross) %></td><td class="num"><%= rand(s.fees) %></td><td class="num"><%= rand(s.payouts) %></td><td><%= date(s.last) %></td></tr><% }) %>
        </tbody>
      </table>
    </div>
  <% } else { %><p class="admin-none">No sales yet.</p><% } %>
  <p class="fineprint">Bank accounts to verify are under <a href="/admin/verifications#bank-accounts">Review</a>. Sellers without bank details are under <a href="/admin/sellers?status=no-payouts">Sellers</a>.</p>
</section>

<%- include('../partials/admin-bottom') %>
