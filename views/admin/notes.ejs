<%- include('../partials/admin-top', { sub: 'Every set of notes, newest first. Published notes are on sale once the seller is verified and has bank details.' }) %>
<% var keep = function (extra) { return '/admin/notes' + qs(Object.assign({ q: q, status: status, seller: seller ? seller.id : '' }, extra)).replace(/\?$/, ''); }; %>

<div class="filter-bar">
  <nav class="chips" aria-label="Show">
    <a class="chip" href="<%= keep({ status: '' }) %>" <%- !status ? 'aria-current="page"' : '' %>>All <span class="chip-count"><%= total %></span></a>
    <% views.forEach(function (v) { %><a class="chip" href="<%= keep({ status: v.value }) %>" <%- status === v.value ? 'aria-current="page"' : '' %>><%= v.label %> <span class="chip-count"><%= v.count %></span></a><% }) %>
  </nav>
  <form method="get" action="/admin/notes" class="filter-search" role="search">
    <% if (status) { %><input type="hidden" name="status" value="<%= status %>"><% } %>
    <% if (seller) { %><input type="hidden" name="seller" value="<%= seller.id %>"><% } %>
    <label for="an-q" class="sr-only">Search notes</label>
    <input id="an-q" type="search" name="q" maxlength="80" value="<%= q %>" placeholder="Title or module code">
    <button class="btn btn-sm btn-ghost" type="submit">Find</button>
  </form>
</div>
<% if (seller) { %><p class="filter-on">Only notes by <a href="/admin/sellers/<%= seller.id %>"><strong><%= seller.display_name %></strong></a> · <a href="<%= keep({ seller: '' }) %>">Show everyone’s</a></p><% } %>

<div class="table-wrap">
  <table class="data">
    <thead><tr><th>Title</th><th>Seller</th><th>Status</th><th class="num">Price</th><th class="num">Sales</th><th><span class="sr-only">Actions</span></th></tr></thead>
    <tbody>
      <% notes.forEach(function (n) { %>
        <tr>
          <td><a href="<%= noteUrl(n) %>"><strong><%= n.title %></strong></a><br><span class="small muted"><%= [n.module_code, n.university].filter(Boolean).join(' · ') %></span></td>
          <td><% if (n.sellers) { %><a href="/admin/sellers/<%= n.sellers.id %>"><%= n.sellers.display_name %></a><% } %></td>
          <td><% if (n.adminHidden) { %><span class="pill pill-bad">Hidden by admin</span><% } else { %><%- include('../partials/status-pill', { status: n.status }) %><% } %></td>
          <td class="num"><%= rand(n.price_cents) %></td>
          <td class="num"><%= n.sales_count %></td>
          <td><%- include('note-actions', { n: n }) %></td>
        </tr>
      <% }) %>
      <% if (!notes.length) { %><tr><td colspan="6" class="muted"><%= q ? 'No notes match “' + q + '”.' : 'No notes in this view.' %></td></tr><% } %>
    </tbody>
  </table>
</div>
<% if (notes.length === 200) { %><p class="fineprint">Showing the newest 200. Search to find older notes.</p><% } %>

<%- include('../partials/admin-bottom') %>
