<%- include('../partials/top', { noindex: true }) %>
<div class="wrap dash">
  <%- include('../partials/admin-nav') %>
  <p><a href="/admin/sellers">All sellers</a></p>
  <div class="dash-grid">
    <div class="card">
      <h2 style="font-size:1.35rem"><%= s.display_name %> <%- include('../partials/status-pill', { status: s.verification_status }) %></h2>
      <dl class="facts">
        <dt>Full name</dt><dd><%= s.full_name || '—' %></dd>
        <dt>Email</dt><dd><%= s.users ? s.users.email : '' %></dd>
        <dt>Storefront</dt><dd><a href="<%= storeUrl(s) %>">/<%= s.slug %></a></dd>
        <dt>Shown as</dt><dd><%= s.degree ? s.degree + ', ' + s.university : '—' %></dd>
        <dt>Submitted</dt><dd><%= s.submitted_at ? date(s.submitted_at) : '—' %></dd>
        <dt>Sales</dt><dd><%= totals.sales %> paid, <%= rand(totals.earnings) %> earned</dd>
        <dt>Payouts</dt><dd><%= s.paystack_subaccount_code ? s.bank_name + ' ••••' + s.account_number_last4 + ' (' + s.paystack_subaccount_code + ')' : 'Not set up' %></dd>
      </dl>
      <h3>Education</h3>
      <% if (!quals.length) { %><p class="muted small">None submitted.</p><% } %>
      <% quals.forEach(function (q) { %>
        <div class="qual-admin-row"><%- include('../partials/status-pill', { status: q.review_status }) %><%- include('qual-detail', { q: q }) %></div>
      <% }) %>
      <h3>ID</h3>
      <p class="small muted">Links expire after 10 minutes. Refresh the page for new ones.</p>
      <div class="form-actions">
        <% if (idUrl) { %><a class="btn btn-ghost btn-sm" href="<%= idUrl %>" target="_blank" rel="noopener noreferrer">Open ID document</a><% } else if (s.verification_status === 'approved') { %><span class="muted small">Checked, then deleted <%= jobsIdDays %> days after approval</span><% } else { %><span class="muted small">No ID document</span><% } %>
      </div>
    </div>
    <div class="card">
      <% var vs = s.verification_status; %>
      <h2 style="font-size:1.35rem"><%= vs === 'approved' ? 'Verification' : 'Decision' %></h2>
      <% if (vs === 'rejected') { %>
        <div class="alert alert-error"><strong>Rejected</strong><p><%= s.verification_note || 'No reason recorded.' %></p></div>
        <p class="muted small">Waiting for the seller to fix this and send their documents again. They’ll show up under Verifications when they do.</p>
      <% } else if (vs === 'unsubmitted') { %>
        <p class="muted">This seller hasn’t sent their documents for verification yet.</p>
      <% } else { %>
        <% if (vs === 'approved') { %><p class="muted small">Verified. Revoking hides all their notes from students until they’re approved again.</p><% } %>
        <form class="form" method="post" action="/admin/sellers/<%= s.id %>/verification" <%- vs === 'approved' ? 'data-confirm="Revoke this seller’s verification? All their notes will be hidden from students."' : '' %>>
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <div class="field">
            <label for="a-note">Reason <%= vs === 'approved' ? '(shown to the seller)' : '(shown to the seller if you reject)' %></label>
            <textarea id="a-note" name="note" maxlength="500" placeholder="e.g. The transcript doesn't show a completed degree. Upload your degree certificate instead."></textarea>
          </div>
          <div class="form-actions">
            <% if (vs === 'pending') { %><button class="btn" type="submit" name="decision" value="approve">Approve seller</button><% } %>
            <button class="btn btn-danger" type="submit" name="decision" value="reject"><%= vs === 'approved' ? 'Revoke verification' : 'Reject' %></button>
          </div>
        </form>
      <% } %>
    </div>
  </div>

  <h2 style="font-size:1.35rem;margin-top:34px">Notes (<%= notes.length %>)</h2>
  <% if (notes.length) { %>
    <div class="table-wrap">
      <table class="data">
        <thead><tr><th>Title</th><th>Status</th><th class="num">Price</th><th class="num">Sales</th></tr></thead>
        <tbody>
          <% notes.forEach(function (n) { %><tr><td><a href="<%= noteUrl(n) %>"><%= n.title %></a></td><td><%- include('../partials/status-pill', { status: n.status }) %></td><td class="num"><%= rand(n.price_cents) %></td><td class="num"><%= n.sales_count %></td></tr><% }) %>
        </tbody>
      </table>
    </div>
  <% } else { %><p class="muted">No notes uploaded.</p><% } %>

  <h2 id="reviews" style="font-size:1.35rem;margin-top:34px">Reviews (<%= locals.reviews ? reviews.length : 0 %>)</h2>
  <% if (locals.reviews && reviews.length) { %>
    <div class="reviews-list">
      <% reviews.forEach(function (r) { %>
        <article class="review <%= r.status === 'hidden' ? 'is-hidden' : '' %>">
          <div class="review-head">
            <span><% if (r.rating) { %><strong><%= '★'.repeat(r.rating) %><%= '☆'.repeat(5 - r.rating) %></strong> · <% } %><%= r.reviewer_name || (r.source ? 'Anonymous' : 'Verified buyer') %> · <% if (r.source) { %><span class="pill pill-muted">From <%= r.source %></span><% } else { %><span class="muted small"><%= r.payment_ref %></span><% } %><% if (r.status === 'hidden') { %> <span class="pill pill-muted">Hidden</span><% } %></span>
            <form method="post" action="/admin/reviews/<%= r.id %>/status">
              <input type="hidden" name="_csrf" value="<%= csrf %>">
              <input type="hidden" name="back" value="/admin/sellers/<%= s.id %>">
              <button class="btn btn-ghost btn-sm" name="status" value="<%= r.status === 'hidden' ? 'published' : 'hidden' %>"><%= r.status === 'hidden' ? 'Show again' : 'Hide' %></button>
            </form>
          </div>
          <% if (r.body) { %><p class="review-body"><%= r.body %></p><% } %>
          <p class="review-by muted"><%= r.source ? (r.original_date ? 'Originally ' + date(r.original_date) + ' · ' : '') + 'Added ' + date(r.created_at) : date(r.created_at) %><%= r.notes_bought ? ' · Bought ' + r.notes_bought : '' %></p>
        </article>
      <% }) %>
    </div>
  <% } else { %><p class="muted">No reviews yet.</p><% } %>

  <details class="card import-review">
    <summary><strong>Add a review from their previous store</strong> <span class="muted small">Shown labelled with where it’s from. Doesn’t count towards their EasyNotes rating.</span></summary>
    <form class="form" method="post" action="/admin/sellers/<%= s.id %>/reviews/import">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="row-2">
        <div class="field"><label for="ir-source">Where it’s from</label><input id="ir-source" type="text" name="source" required maxlength="80" placeholder="e.g. pgdanotes.co.za"></div>
        <div class="field"><label for="ir-url">Link to it <span class="muted">(optional)</span></label><input id="ir-url" type="text" inputmode="url" name="source_url" maxlength="300" placeholder="https://pgdanotes.co.za/#reviews"></div>
      </div>
      <div class="row-2">
        <div class="field"><label for="ir-name">Reviewer <span class="muted">(optional)</span></label><input id="ir-name" type="text" name="reviewer_name" maxlength="60" placeholder="First name and initial, e.g. Raquel P."></div>
        <div class="field"><label for="ir-rating">Stars <span class="muted">(only if the original had them)</span></label>
          <select id="ir-rating" name="rating" data-native><option value="">No star rating</option><% for (var i = 5; i >= 1; i--) { %><option value="<%= i %>"><%= i %> <%= i === 1 ? 'star' : 'stars' %></option><% } %></select>
        </div>
      </div>
      <div class="field"><label for="ir-date">Original date <span class="muted">(optional)</span></label><input id="ir-date" type="date" name="original_date" style="max-width:220px"></div>
      <div class="field"><label for="ir-body">Review, word for word</label><textarea id="ir-body" name="body" required maxlength="1000" style="min-height:120px"></textarea></div>
      <div class="form-actions"><button class="btn" type="submit">Add review</button></div>
    </form>
  </details>
</div>
<%- include('../partials/bottom') %>
