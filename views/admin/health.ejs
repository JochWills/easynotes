<%- include('../partials/top', { noindex: true }) %>
<div class="wrap dash">
  <%- include('../partials/admin-nav') %>
  <% var bad = checks.filter(function (c) { return c.status === 'fail'; }).length, warn = checks.filter(function (c) { return c.status === 'warn'; }).length; %>
  <div class="alert <%= bad ? 'alert-error' : warn ? 'alert-info' : 'alert-ok' %>">
    <%= bad ? bad + (bad === 1 ? ' problem needs' : ' problems need') + ' fixing' : warn ? 'Working, with ' + warn + (warn === 1 ? ' thing' : ' things') + ' to look at' : 'Everything is working' %>
    <p>Checked just now. Refresh to check again.</p>
  </div>
  <ul class="checks">
    <% checks.forEach(function (c) { %>
      <li class="check-row">
        <span class="dot dot-<%= c.status %>" aria-label="<%= { ok: 'OK', warn: 'Warning', fail: 'Problem' }[c.status] %>"><%= { ok: '✓', warn: '!', fail: '×' }[c.status] %></span>
        <div>
          <h3><%= c.name %></h3>
          <p><%= c.detail %></p>
          <% if (c.fix) { %><p class="fix">Fix: <%= c.fix %></p><% } %>
        </div>
      </li>
    <% }) %>
  </ul>

  <div class="dash-grid admin-section">
    <section class="card">
      <h2 style="font-size:1.2rem">Test email</h2>
      <p class="muted">Sends a short email to <strong><%= user.email %></strong> from the noreply address.</p>
      <form method="post" action="/admin/health/test-email"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn" type="submit">Send test email</button></form>
    </section>
    <section class="card">
      <h2 style="font-size:1.2rem">Server</h2>
      <dl class="kv">
        <dt>Version</dt><dd><%= app.commit %></dd>
        <dt>Running for</dt><dd><%= app.uptime %></dd>
        <dt>Memory</dt><dd><%= app.memory %></dd>
        <dt>Node</dt><dd><%= app.node %></dd>
        <dt>Mode</dt><dd><%= app.env %></dd>
      </dl>
    </section>
  </div>
</div>
<%- include('../partials/bottom') %>
