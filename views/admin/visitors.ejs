<%- include('../partials/admin-top', { sub: 'Who visits, where they come from, and how many buy. Anonymous, no cookies.' }) %>

<div class="filter-bar">
  <nav class="chips" aria-label="Time period">
    <% periods.forEach(function (p) { %><a class="chip" href="/admin/visitors?period=<%= p[0] %>" <%- p[0] === period ? 'aria-current="page"' : '' %>><%= p[1] %></a><% }) %>
  </nav>
</div>

<% if (!stats) { %>
  <div class="alert alert-info">
    <strong>Visitor stats aren’t set up in the database yet.</strong>
    <p>Run <code>supabase/schema.sql</code> in Supabase → SQL Editor. Visits are counted from then on.</p>
  </div>
<% } else { %>
  <%
    var f = stats.funnel || {};
    var pct = function (n, of) { return of ? Math.round(n / of * 100) + '%' : '0%'; };
    var num = function (n) { return Number(n || 0).toLocaleString('en-ZA'); };
    var daily = stats.daily || [];
    var totalVisitors = daily.reduce(function (t, d) { return t + d.visitors; }, 0);
    var peak = Math.max(1, ...daily.map(function (d) { return d.visitors; }));
    var dayLabel = function (d) { return new Date(d + 'T00:00:00Z').toLocaleDateString('en-GB', { weekday: 'short', day: 'numeric', month: 'short', timeZone: 'UTC' }); };
    var shortDay = function (d) { return new Date(d + 'T00:00:00Z').toLocaleDateString('en-GB', { day: 'numeric', month: 'short', timeZone: 'UTC' }); };
    var dev = stats.devices || {};
    var devTotal = Object.keys(dev).reduce(function (t, k) { return t + dev[k]; }, 0);
    var sources = stats.sources || [];
    var srcTop = Math.max(1, ...sources.map(function (s) { return s.visitors; }));
  %>

  <div class="kpis">
    <div class="kpi"><span>Visitors</span><b><%= num(totalVisitors) %></b></div>
    <div class="kpi"><span>Page views</span><b><%= num(stats.views) %></b></div>
    <div class="kpi"><span>Added to cart</span><b><%= num(f.cart) %></b><small><%= pct(f.cart, f.visitors) %> of visitors</small></div>
    <div class="kpi"><span>Paid</span><b><%= num(f.paid) %></b><small><%= pct(f.paid, f.visitors) %> of visitors</small></div>
  </div>

  <% if (daily.length > 1) { %>
  <section class="vis-card" aria-labelledby="daily-h">
    <h2 class="vis-h" id="daily-h">Visitors per day</h2>
    <div class="vchart" role="img" aria-label="Unique visitors per day, from <%= dayLabel(daily[0].day) %> to <%= dayLabel(daily[daily.length - 1].day) %>. Busiest day: <%= peak %>.">
      <div class="vchart-axis" aria-hidden="true"><span><%= peak %></span><span>0</span></div>
      <div class="vchart-plot">
        <% daily.forEach(function (d) { %>
          <div class="vchart-col" tabindex="0">
            <span class="vchart-bar" style="height:<%= d.visitors ? Math.max(2, Math.round(d.visitors / peak * 100)) : 0 %>%"></span>
            <span class="vchart-tip" role="tooltip"><strong><%= dayLabel(d.day) %></strong><%= d.visitors %> <%= d.visitors === 1 ? 'visitor' : 'visitors' %> · <%= d.views %> <%= d.views === 1 ? 'view' : 'views' %></span>
          </div>
        <% }) %>
      </div>
      <div class="vchart-days" aria-hidden="true"><span><%= shortDay(daily[0].day) %></span><span><%= shortDay(daily[daily.length - 1].day) %></span></div>
    </div>
  </section>
  <% } %>

  <div class="vis-grid">
    <section class="vis-card" aria-labelledby="funnel-h">
      <h2 class="vis-h" id="funnel-h">From visit to sale</h2>
      <ol class="vis-rows">
        <% [['Visited', f.visitors], ['Looked at notes', f.notes], ['Added to cart', f.cart], ['Started paying', f.checkout], ['Paid', f.paid]].forEach(function (s, i) { %>
          <li class="vis-row">
            <span class="vis-label"><%= s[0] %></span>
            <span class="vis-num"><%= num(s[1]) %><% if (i) { %> <small><%= pct(s[1], f.visitors) %></small><% } %></span>
            <span class="vis-track" aria-hidden="true"><span style="width:<%= f.visitors ? Math.round((s[1] || 0) / f.visitors * 100) : 0 %>%"></span></span>
          </li>
        <% }) %>
      </ol>
    </section>

    <section class="vis-card" aria-labelledby="sources-h">
      <h2 class="vis-h" id="sources-h">Where they come from</h2>
      <% if (sources.length) { %>
        <ol class="vis-rows">
          <% sources.forEach(function (s) { %>
            <li class="vis-row">
              <span class="vis-label" <%- sourceHints[s.source] ? 'title="' + sourceHints[s.source] + '"' : '' %>><%= s.source %></span>
              <span class="vis-num"><%= num(s.visitors) %><% if (s.paid) { %> <small><%= s.paid %> paid</small><% } %></span>
              <span class="vis-track" aria-hidden="true"><span style="width:<%= Math.round(s.visitors / srcTop * 100) %>%"></span></span>
            </li>
          <% }) %>
        </ol>
        <% if (devTotal) { %><p class="vis-foot"><%= ['phone', 'computer', 'tablet'].filter(function (k) { return dev[k]; }).map(function (k) { return pct(dev[k], devTotal) + ' on ' + (k === 'phone' ? 'phones' : k === 'computer' ? 'computers' : 'tablets'); }).join(' · ') %></p><% } %>
      <% } else { %><p class="vis-empty">No visits yet.</p><% } %>
    </section>

    <section class="vis-card" aria-labelledby="notes-h">
      <h2 class="vis-h" id="notes-h">Most viewed notes</h2>
      <% if ((stats.notes || []).length) { %>
        <ol class="vis-list">
          <% stats.notes.forEach(function (n) { %>
            <li><span class="vis-list-name"><% if (n.title) { %><a href="<%= noteUrl(n) %>"><%= n.title %></a><% } else { %><span class="muted">Deleted notes</span><% } %></span><span class="vis-list-num"><%= num(n.views) %> <small><%= n.views === 1 ? 'view' : 'views' %><%= n.carts ? ' · ' + n.carts + ' in cart' : '' %></small></span></li>
          <% }) %>
        </ol>
      <% } else { %><p class="vis-empty">No note views yet.</p><% } %>
    </section>

    <section class="vis-card" aria-labelledby="pages-h">
      <h2 class="vis-h" id="pages-h">Top pages</h2>
      <% if ((stats.pages || []).length) { %>
        <ol class="vis-list">
          <% stats.pages.forEach(function (p) { %>
            <li><span class="vis-list-name"><a href="<%= p.path %>"><%= p.path === '/' ? 'Home' : p.path %></a></span><span class="vis-list-num"><%= num(p.views) %> <small><%= p.views === 1 ? 'view' : 'views' %></small></span></li>
          <% }) %>
        </ol>
      <% } else { %><p class="vis-empty">No page views yet.</p><% } %>
    </section>
  </div>

  <details class="vis-help">
    <summary>How this is counted</summary>
    <ul>
      <li>Each visitor is an anonymous code that changes daily, so visitors are counted per day. Logged-in sellers and admins, and search engine robots, aren’t counted.</li>
      <li><strong>Direct</strong> means typed in, bookmarks, or apps that hide where a link came from (WhatsApp usually does).</li>
      <li>To see which post or group sent people, add <code>?utm_source=</code> to links you share, e.g. <code><%= locals.baseUrl || "https://easynotes.co.za" %>/?utm_source=ucc-whatsapp-group</code>.</li>
      <li><strong>Started paying</strong> means they opened the Paystack payment. People can buy straight from a note page, so it can be higher than “Added to cart”.</li>
    </ul>
  </details>
<% } %>

<%- include('../partials/admin-bottom') %>
