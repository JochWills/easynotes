<%- include('../partials/top', { noindex: true }) %>
<div class="wrap dash">
  <%- include('../partials/admin-nav') %>
  <div style="display:flex;gap:16px;flex-wrap:wrap;align-items:center;margin-bottom:22px">
  <div class="chips">
    <a class="chip" href="/admin/sellers<%= q ? qs({ q: q }) : '' %>" <%- !status ? 'aria-current="page"' : '' %>>All</a>
    <% statuses.forEach(function (s) { %><a class="chip" href="/admin/sellers<%= qs({ status: s, q: q }) %>" <%- status === s ? 'aria-current="page"' : '' %>><%= { pending: 'In review', approved: 'Verified', rejected: 'Not approved', unsubmitted: 'Not started' }[s] %></a><% }) %>
  </div>
    <form method="get" action="/admin/sellers" class="search" style="margin:0;box-shadow:none;flex:1;max-width:420px" role="search">
      <% if (status) { %><input type="hidden" name="status" value="<%= status %>"><% } %>
      <label for="as-q" class="sr-only">Find a seller</label>
      <input id="as-q" type="search" name="q" maxlength="80" value="<%= q %>" placeholder="Name, link or email">
      <button class="btn btn-sm" type="submit">Find</button>
    </form>
  </div>
  <div class="table-wrap">
    <table class="data">
      <thead><tr><th>Seller</th><th>Email</th><th>Degree</th><th>Status</th><th>Payouts</th><th>Joined</th></tr></thead>
      <tbody>
        <% sellers.forEach(function (s) { %>
          <tr>
            <td><a href="/admin/sellers/<%= s.id %>"><%= s.display_name %></a></td>
            <td><%= s.users ? s.users.email : '' %></td>
            <td><%= s.degree ? s.degree + ', ' + s.university : '—' %></td>
            <td><%- include('../partials/status-pill', { status: s.verification_status }) %></td>
            <td><%= s.paystack_subaccount_code ? 'Set up' : 'Missing' %></td>
            <td><%= date(s.created_at) %></td>
          </tr>
        <% }) %>
        <% if (!sellers.length) { %><tr><td colspan="6" class="muted">No sellers in this view.</td></tr><% } %>
      </tbody>
    </table>
  </div>
</div>
<%- include('../partials/bottom') %>
