<%# Verify or deny a seller's new bank account. Needs s (the seller) and back (where to return). %>
<%- include('decide', {
  action: '/admin/sellers/' + s.id + '/payout-review', id: 'bank-' + s.id, back: back,
  yes: ['approve', 'I’ve verified it in Paystack'], no: ['deny', 'Deny bank details'],
  reasons: ['The account must be in your own name.', 'The account holder doesn’t match your ID.'],
  placeholder: 'e.g. The account must be in your own name.',
  confirm: ['Deny these bank details?', 'Their bank details are removed and their notes are hidden until they add new ones.', 'Deny'],
}) %>
