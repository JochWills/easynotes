<%- include('../partials/admin-top', { sub: 'Reports from students and rights holders, uploads the automatic check flagged, and payments that didn’t match an order. Urgent ones come first.' }) %>
<p class="muted small">Handle copyright takedown requests within 2 working days (see the <a href="/copyright">copyright page</a>). Each item stays here until you mark it resolved.</p>
  <% if (items === null) { %>
    <div class="alert alert-info">The activity log table isn’t set up, so reports can’t be listed. Run the <strong>events</strong> snippet from <code>supabase/schema.sql</code>.</div>
  <% } else if (!items.length) { %>
    <div class="empty"><h3>Nothing to check</h3><p>New reports, flagged uploads and payment problems will appear here.</p></div>
  <% } else { %>
    <ul class="report-list">
      <% items.forEach(function (e) { var d = e.detail || {}; var n = notesById[d.note_id]; var takedown = d.reason === 'copyright_mine'; %>
        <% if (e.kind === 'payment.unmatched' || e.kind === 'payment.mismatch') { %>
        <li class="report-item card is-urgent">
          <div class="report-head">
            <span class="pill pill-bad">Payment problem</span>
            <time class="small muted" datetime="<%= new Date(e.created_at).toISOString() %>"><%= date(e.created_at) %></time>
          </div>
          <h3>Payment <%= d.reference %></h3>
          <% if (e.kind === 'payment.unmatched') { %>
            <p>Paystack took <strong><%= rand(d.amount_cents) %></strong><%= d.email ? ' from ' + d.email : '' %>, but there are no orders for this reference (they were deleted, probably with the notes, before the payment came through). The buyer has nothing to download: refund them in Paystack or sort it out by email.</p>
          <% } else { %>
            <p>Paystack took <strong><%= rand(d.paid_cents) %> <%= d.currency || '' %></strong>, but the orders add up to <strong><%= rand(d.expected_cents) %></strong>, so they weren’t marked paid. Check the payment in Paystack.</p>
          <% } %>
          <div class="actions">
            <a class="btn btn-ghost btn-sm" href="/admin/orders?reference=<%= encodeURIComponent(d.reference || '') %>">Look up orders</a>
            <form method="post" action="/admin/reports/<%= e.id %>/resolve"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-ghost btn-sm" type="submit">Mark resolved</button></form>
          </div>
        </li>
        <% return; } %>
        <li class="report-item card<%= takedown ? ' is-urgent' : '' %>">
          <div class="report-head">
            <% if (e.kind === 'note.flagged') { %>
              <span class="pill pill-wait">Automatic check</span>
            <% } else if (takedown) { %>
              <span class="pill pill-bad">Takedown request</span>
            <% } else { %>
              <span class="pill pill-muted">Report</span>
            <% } %>
            <time class="small muted" datetime="<%= new Date(e.created_at).toISOString() %>"><%= date(e.created_at) %></time>
          </div>
          <h3>
            <% if (n) { %><a href="<%= noteUrl(n) %>"><%= n.title %></a><% } else { %><%= d.title || 'Notes' %> <span class="muted small">(no longer exists)</span><% } %>
          </h3>
          <p class="small muted">
            <% if (n && n.sellers) { %>By <a href="/admin/sellers/<%= n.sellers.id %>"><%= n.sellers.display_name %></a> · <% } %>
            <% if (n) { %>Now: <%- include('../partials/status-pill', { status: n.status }) %><% } %>
          </p>
          <% if (e.kind === 'note.flagged') { %>
            <ul class="flag-list"><% (d.flags || []).forEach(function (f) { %><li><%= f %></li><% }) %></ul>
            <p class="small muted">Open the PDF to check. Flags are hints, not proof.</p>
          <% } else { %>
            <p><strong><%= reasons[d.reason] || d.reason %></strong></p>
            <blockquote class="report-details"><%= d.details %></blockquote>
            <p class="small">From <%= d.name || 'someone who didn’t give a name' %> · <a href="mailto:<%= d.email %>?subject=<%= encodeURIComponent('Your report about ' + (d.title || 'notes on EasyNotes')) %>"><%= d.email %></a></p>
          <% } %>
          <div class="actions">
            <% if (n) { %><a class="btn btn-ghost btn-sm" href="/admin/notes/<%= n.id %>/file" target="_blank" rel="noopener">Open PDF</a><% } %>
            <% if (d.previous_file) { %><a class="btn btn-ghost btn-sm" href="/admin/reports/<%= e.id %>/previous-file" target="_blank" rel="noopener">Open previous PDF</a><% } %>
            <% if (n && n.status !== 'removed' && n.status !== 'deleted') { %>
              <form method="post" action="/admin/notes/<%= n.id %>/status" data-confirm-title="Remove “<%= n.title %>”?" data-confirm="It’s taken off EasyNotes and the seller can’t publish it again. People who bought it can still download it." data-confirm-yes="Remove notes"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-danger btn-sm" name="action" value="remove">Remove notes</button></form>
            <% } %>
            <form method="post" action="/admin/reports/<%= e.id %>/resolve"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-ghost btn-sm" type="submit">Mark resolved</button></form>
          </div>
        </li>
      <% }) %>
    </ul>
  <% } %>
<%- include('../partials/admin-bottom') %>
