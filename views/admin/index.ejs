<%- include('../partials/admin-top', { sub: 'What needs you, and how EasyNotes is doing.' }) %>

<section class="admin-block" aria-labelledby="todo-h">
  <h2 class="admin-h2" id="todo-h">To do</h2>
  <% if (!todo.length) { %>
    <div class="todo-clear">
      <span class="todo-clear-ico" aria-hidden="true">✓</span>
      <div><h3>All caught up</h3><p>Nothing needs you right now. New sellers, bank accounts and reports show up here.</p></div>
    </div>
  <% } else { %>
    <ul class="todo">
      <% todo.forEach(function (t) { %>
        <li class="todo-<%= t.tone %>">
          <span class="todo-count" aria-hidden="true"><%= t.count %></span>
          <div><h3><%= t.title %></h3><p><%= t.sub %></p></div>
          <a class="btn btn-sm <%= t.tone === 'later' ? 'btn-ghost' : t.tone === 'urgent' ? 'btn-danger' : 'btn-hi' %>" href="<%= t.href %>"><%= t.label %></a>
        </li>
      <% }) %>
    </ul>
  <% } %>
</section>

<section class="admin-block" aria-labelledby="month-h">
  <div class="admin-h2-row"><h2 class="admin-h2" id="month-h"><%= monthLabel %> so far</h2><a href="/admin/money">Money details</a></div>
  <div class="kpis">
    <div class="kpi"><span>EasyNotes revenue</span><b><%= rand(month.fees) %></b><small>Last month: <%= rand(lastMonth.fees) %></small></div>
    <div class="kpi"><span>Gross sales</span><b><%= rand(month.gross) %></b><small>Last month: <%= rand(lastMonth.gross) %></small></div>
    <div class="kpi"><span>Paid orders</span><b><%= month.sales %></b><small>Last month: <%= lastMonth.sales %></small></div>
    <div class="kpi"><span>Notes on sale</span><b><%= liveNotes %></b><small>From <%= sellerCount %> verified <%= sellerCount === 1 ? 'seller' : 'sellers' %></small></div>
  </div>
  <p class="fineprint">All time: <%= rand(totals.fees) %> EasyNotes revenue from <%= rand(totals.gross) %> in sales (<%= totals.sales %> paid <%= totals.sales === 1 ? 'order' : 'orders' %>).</p>
</section>

<div class="admin-cols">
  <section aria-labelledby="orders-h">
    <div class="admin-h2-row"><h2 class="admin-h2" id="orders-h">Latest orders</h2><a href="/admin/orders?status=all">All orders</a></div>
    <% if (recent.length) { %>
      <ul class="mini-list">
        <% recent.forEach(function (o) { %>
          <li>
            <a href="/admin/orders?reference=<%= o.reference %>">
              <span class="mini-main"><strong><%= o.notes ? o.notes.title : o.reference %></strong><span class="small muted"><%= o.buyer_name || o.email %> · <%= date(o.created_at) %></span></span>
              <span class="mini-side"><strong><%= rand(o.amount_cents) %></strong><%- include('../partials/status-pill', { status: o.status, kind: 'order' }) %></span>
            </a>
          </li>
        <% }) %>
      </ul>
    <% } else { %><p class="muted">No orders yet.</p><% } %>
  </section>
  <section aria-labelledby="activity-h">
    <div class="admin-h2-row"><h2 class="admin-h2" id="activity-h">Activity</h2><a href="/admin/activity">See all</a></div>
    <%- include('../partials/activity', { items: activity }) %>
  </section>
</div>

<%- include('../partials/admin-bottom') %>
