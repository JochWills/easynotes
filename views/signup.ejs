<%- include('partials/top', { noindex: true }) %>
<div class="auth-page">
  <div class="auth auth-login">
    <div class="card auth-card">
      <h1>Start selling</h1>
      <p class="muted auth-lead">Create your seller account. Next you’ll verify your degree and add the bank account you’ll be paid into.</p>
      <form class="form" method="post" action="/signup" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <% var sameName = values.same_name !== false; %>
        <div class="field <%= errors.full_name ? 'has-error' : '' %>">
          <label for="s-full">Your full name</label>
          <input id="s-full" type="text" name="full_name" maxlength="80" value="<%= values.full_name || '' %>" required autocomplete="name" aria-describedby="s-full-hint">
          <span class="hint" id="s-full-hint">As it appears on your ID. We use it for your account and to check your documents.</span>
          <%- include('partials/field-error', { name: 'full_name' }) %>
        </div>
        <div class="field store-name <%= errors.display_name ? 'has-error' : '' %>" data-same-name>
          <label class="check"><input type="checkbox" name="same_name" <%= sameName ? 'checked' : '' %>> <span>Use my name as my storefront name</span></label>
          <div class="store-name-input" data-store-name>
            <label for="s-name">Storefront name</label>
            <input id="s-name" type="text" name="display_name" maxlength="80" value="<%= values.display_name || '' %>" autocomplete="off" aria-describedby="s-name-hint">
            <span class="hint" id="s-name-hint">What students see on your notes and storefront. A real name builds the most trust.</span>
            <%- include('partials/field-error', { name: 'display_name' }) %>
          </div>
        </div>
        <div class="field <%= errors.email ? 'has-error' : '' %>">
          <label for="s-email">Email</label>
          <input id="s-email" type="email" name="email" maxlength="200" value="<%= values.email || '' %>" required autocomplete="email">
          <%- include('partials/field-error', { name: 'email' }) %>
        </div>
        <div class="field <%= errors.password ? 'has-error' : '' %>">
          <label for="s-pass">Password</label>
          <div class="pass-wrap">
            <input id="s-pass" type="password" name="password" maxlength="72" required minlength="8" autocomplete="new-password" aria-describedby="s-pass-hint" data-pass-meter="s-pass-meter">
            <button class="pass-toggle" type="button" data-pass-toggle aria-controls="s-pass" aria-pressed="false" hidden>Show</button>
          </div>
          <div class="pass-meter" id="s-pass-meter" hidden>
            <div class="pass-bars" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
            <span class="pass-label" aria-live="polite"></span>
          </div>
          <span class="hint" id="s-pass-hint">At least 8 characters. A longer mix of words, numbers and symbols is stronger.</span>
          <%- include('partials/field-error', { name: 'password' }) %>
        </div>
        <div class="field">
          <label class="check"><input type="checkbox" name="accept" required> <span>I agree to the <a href="/seller-terms" target="_blank">seller terms</a>, including that I’ll only sell notes I wrote myself.</span></label>
          <%- include('partials/field-error', { name: 'accept' }) %>
        </div>
        <button class="btn btn-hi btn-block" type="submit">Create account</button>
      </form>
      <div class="auth-split"><span>Already selling?</span></div>
      <a class="btn btn-ghost btn-block" href="/login">Log in</a>
    </div>
    <p class="auth-foot">Just buying notes? You don’t need an account. <a href="/notes">Browse notes</a></p>
  </div>
</div>
<%- include('partials/bottom') %>
