<%- include('partials/top', { noindex: true }) %>
<div class="auth">
  <div class="card">
    <h1>Create a seller account</h1>
    <p class="muted">Next you’ll verify your degree and add the bank account you’ll be paid into.</p>
    <form class="form" method="post" action="/signup" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="field <%= errors.display_name ? 'has-error' : '' %>">
        <label for="s-name">Name on your storefront</label>
        <input id="s-name" type="text" name="display_name" value="<%= values.display_name || '' %>" required autocomplete="name" aria-describedby="s-name-hint">
        <span class="hint" id="s-name-hint">Your real name works best. Students trust a person they can see is qualified.</span>
        <%- include('partials/field-error', { name: 'display_name' }) %>
      </div>
      <div class="field <%= errors.email ? 'has-error' : '' %>">
        <label for="s-email">Email</label>
        <input id="s-email" type="email" name="email" value="<%= values.email || '' %>" required autocomplete="email">
        <%- include('partials/field-error', { name: 'email' }) %>
      </div>
      <div class="field <%= errors.password ? 'has-error' : '' %>">
        <label for="s-pass">Password</label>
        <input id="s-pass" type="password" name="password" required minlength="8" autocomplete="new-password">
        <span class="hint">At least 8 characters.</span>
        <%- include('partials/field-error', { name: 'password' }) %>
      </div>
      <div class="field">
        <label class="check"><input type="checkbox" name="accept" required> <span>I agree to the <a href="/seller-terms" target="_blank">seller terms</a>, including that I’ll only sell notes I wrote myself.</span></label>
        <%- include('partials/field-error', { name: 'accept' }) %>
      </div>
      <button class="btn btn-block" type="submit">Create account</button>
    </form>
    <p class="fineprint">Already selling? <a href="/login">Log in</a>.</p>
  </div>
</div>
<%- include('partials/bottom') %>
