<%- include('partials/top') %>
<section class="page-head">
  <div class="wrap">
    <h1><%= filters.q ? 'Results for “' + filters.q + '”' : filters.subject ? filters.subject + ' notes' : (filters.university ? filters.university : 'Browse notes') %></h1>
    <p><%= count %> <%= count === 1 ? 'set' : 'sets' %> of notes<%= filters.level ? ' at ' + filters.level.toLowerCase() + ' level' : '' %>.</p>
  </div>
</section>
<div class="wrap browse">
  <% var activeFilters = [filters.q, filters.subject, filters.university, filters.level].filter(Boolean).length; %>
  <button class="filters-toggle" type="button" aria-expanded="false" aria-controls="filters" data-filters-toggle>
    <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M7 12h10M10 18h4" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>
    <span>Filters</span><% if (activeFilters) { %><span class="filters-count"><%= activeFilters %> on</span><% } %>
    <svg class="filters-chev" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </button>
  <form class="filters" id="filters" method="get" action="/notes" data-autosubmit role="search" aria-label="Filter notes">
    <div class="field">
      <label for="f-q">Search</label>
      <input id="f-q" type="search" name="q" maxlength="80" value="<%= filters.q %>" placeholder="Module code or subject">
    </div>
    <div class="field">
      <label for="f-subject">Subject</label>
      <select id="f-subject" name="subject">
        <option value="">All subjects</option>
        <% subjects.forEach(function (s) { %><option <%= filters.subject === s ? 'selected' : '' %>><%= s %></option><% }) %>
      </select>
    </div>
    <div class="field">
      <label for="f-uni">Institution</label>
      <select id="f-uni" name="university">
        <option value="">All institutions</option>
        <% institutions.forEach(function (u) { %><option <%= filters.university === u ? 'selected' : '' %>><%= u %></option><% }) %>
      </select>
    </div>
    <div class="field">
      <label for="f-level">Level</label>
      <select id="f-level" name="level">
        <option value="">All levels</option>
        <% levels.forEach(function (l) { %><option <%= filters.level === l ? 'selected' : '' %>><%= l %></option><% }) %>
      </select>
    </div>
    <button class="btn btn-block" type="submit">Show notes</button>
    <% if (filters.q || filters.subject || filters.university || filters.level) { %><a href="/notes" class="small">Clear filters</a><% } %>
  </form>

  <div>
    <% if (notes.length) { %>
      <div class="results-bar">
        <p>Showing <strong><%= notes.length %></strong> of <%= count %></p>
        <div class="sort-by">
          <label for="f-sort">Sort by</label>
          <select id="f-sort" name="sort" form="filters">
            <option value="new" <%= filters.sort === 'new' ? 'selected' : '' %>>Newest</option>
            <option value="popular" <%= filters.sort === 'popular' ? 'selected' : '' %>>Most bought</option>
            <option value="price_asc" <%= filters.sort === 'price_asc' ? 'selected' : '' %>>Price: low to high</option>
            <option value="price_desc" <%= filters.sort === 'price_desc' ? 'selected' : '' %>>Price: high to low</option>
          </select>
        </div>
      </div>
      <div class="grid-notes">
        <% notes.forEach(function (n) { %><%- include('partials/note-card', { n: n }) %><% }) %>
      </div>
      <% if (pages > 1) { %>
        <nav class="pagination" aria-label="Pages">
          <% if (page > 1) { %><a class="btn btn-ghost btn-sm" href="/notes<%= qs(Object.assign({}, filters, { page: page - 1 })) %>">Previous</a><% } %>
          <span>Page <%= page %> of <%= pages %></span>
          <% if (page < pages) { %><a class="btn btn-ghost btn-sm" href="/notes<%= qs(Object.assign({}, filters, { page: page + 1 })) %>">Next</a><% } %>
        </nav>
      <% } %>
    <% } else { %>
      <div class="empty">
        <h3>No notes match yet</h3>
        <p>Try the module code without spaces, a broader subject, or clear the institution filter. New notes are added as sellers are verified.</p>
        <a class="btn btn-ghost" href="/notes">See all notes</a>
      </div>
    <% } %>
  </div>
</div>
<%- include('partials/bottom') %>
