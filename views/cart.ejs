<%- include('partials/top', { noindex: true }) %>
<div class="wrap cart-page">
  <h1>Your cart</h1>
  <% if (dropped) { %><div class="alert alert-info">Some notes in your cart are no longer for sale, so we removed them.</div><% } %>
  <% if (!notes.length) { %>
    <div class="empty">
      <h3>Your cart is empty</h3>
      <p>Add notes from any module and pay for them all at once.</p>
      <a class="btn btn-hi" href="/notes">Browse notes</a>
    </div>
  <% } else { %>
    <div class="cart-grid">
      <ul class="cart-list">
        <% notes.forEach(function (n) { %>
          <li class="cart-item">
            <div>
              <% if (n.module_code) { %><span class="tab"><%= n.module_code %></span><% } %>
              <h3><a href="<%= noteUrl(n) %>"><%= n.title %></a></h3>
              <span class="small muted"><%= n.university %> · by <%= n.sellers.display_name %><%= n.page_count ? ' · ' + n.page_count + ' pages' : '' %></span>
            </div>
            <div class="cart-item-end">
              <span class="price"><%= rand(n.price_cents) %></span>
              <form method="post" action="/cart/remove/<%= n.id %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="linklike cart-remove" type="submit">Remove<span class="sr-only"> <%= n.title %></span></button></form>
            </div>
          </li>
        <% }) %>
      </ul>
      <aside class="buy-box" aria-label="Checkout">
        <div class="cart-total"><span><%= notes.length %> <%= notes.length === 1 ? 'set' : 'sets' %> of notes</span><span class="price"><%= rand(total) %></span></div>
        <form class="form" method="post" action="/checkout" data-checkout>
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <div class="field">
            <label for="cart-name">Your name</label>
            <input id="cart-name" type="text" name="name" required minlength="2" maxlength="100" autocomplete="name" placeholder="First and last name">
          </div>
          <div class="field">
            <label for="cart-email">Your email</label>
            <input id="cart-email" type="email" name="email" maxlength="200" required autocomplete="email" placeholder="you@example.com">
            <span class="hint">Your receipt and download links go here.</span>
          </div>
          <label class="check">
            <input type="checkbox" name="accept" required>
            <span>I understand these are digital downloads and <a href="/terms">all sales are final</a>.</span>
          </label>
          <button class="btn btn-hi btn-block" type="submit">Pay <%= rand(total) %></button>
        </form>
        <p class="fineprint">Secure checkout with card, EFT and more. EasyNotes never sees your card details.</p>
        <p class="fineprint"><a href="/notes">Keep browsing</a></p>
      </aside>
    </div>
  <% } %>
</div>
<%- include('partials/bottom') %>
