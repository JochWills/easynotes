<%# Contents of the slide-in cart panel, loaded from /cart/panel each time it opens. %>
<% if (dropped) { %><div class="alert alert-info">Some notes in your cart are no longer for sale, so we removed them.</div><% } %>
<% if (!notes.length) { %>
  <div class="drawer-empty">
    <svg width="44" height="44" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 4h2.2l2.1 10.4a1.6 1.6 0 001.6 1.3h8.4a1.6 1.6 0 001.6-1.2L20.5 8H6.1" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><circle cx="9.5" cy="19.5" r="1.3" fill="currentColor"/><circle cx="17" cy="19.5" r="1.3" fill="currentColor"/></svg>
    <h3>Your cart is empty</h3>
    <p>Add notes from any module and pay for them all at once.</p>
    <a class="btn btn-hi" href="/notes">Browse notes</a>
  </div>
<% } else { %>
  <ul class="drawer-list">
    <% notes.forEach(function (n) { %>
      <li class="drawer-item">
        <div class="drawer-item-main">
          <% if (n.module_code) { %><span class="tab"><%= n.module_code %></span><% } %>
          <a class="drawer-item-title" href="<%= noteUrl(n) %>"><%= n.title %></a>
          <span class="small muted">by <%= n.sellers.display_name %><%= n.page_count ? ' · ' + n.page_count + ' pages' : '' %></span>
        </div>
        <div class="drawer-item-end">
          <span class="drawer-price"><%= rand(n.price_cents) %></span>
          <form method="post" action="/cart/remove/<%= n.id %>" data-cart-remove="<%= n.id %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="linklike cart-remove" type="submit">Remove<span class="sr-only"> <%= n.title %></span></button></form>
        </div>
      </li>
    <% }) %>
  </ul>
  <div class="drawer-foot">
    <div class="cart-total"><span><%= notes.length %> <%= notes.length === 1 ? 'set' : 'sets' %> of notes</span><span class="price"><%= rand(total) %></span></div>
    <form class="form" method="post" action="/checkout">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="field">
        <label for="drawer-name">Your name</label>
        <input id="drawer-name" type="text" name="name" required minlength="2" maxlength="100" autocomplete="name" placeholder="First and last name">
      </div>
      <div class="field">
        <label for="drawer-email">Your email</label>
        <input id="drawer-email" type="email" name="email" required autocomplete="email" placeholder="you@example.com">
        <span class="hint">Your receipt and download links go here.</span>
      </div>
      <label class="check">
        <input type="checkbox" name="accept" required>
        <span>I understand these are digital downloads and <a href="/terms">all sales are final</a>.</span>
      </label>
      <button class="btn btn-hi btn-block" type="submit">Pay <%= rand(total) %></button>
    </form>
    <p class="fineprint">Secure checkout with card, EFT and more. EasyNotes never sees your card details.</p>
  </div>
<% } %>
