<div class="dash-title">
  <h1><%= title %></h1>
  <% if (me.verification_status === 'approved' && (tab !== 'notes' || locals.notesList)) { %><a class="btn btn-sm" href="/seller/notes/new">Upload notes</a><% } %>
</div>
<nav class="dash-nav" aria-label="Seller">
  <% [['overview','/seller','Overview'],['notes','/seller/notes','Notes'],['payouts','/seller/payouts','Payouts'],['profile','/seller/profile','Storefront'],['verification','/seller/verification', me.verification_status === 'approved' ? 'Education' : 'Verification']].forEach(function (t) { %>
    <a href="<%= t[1] %>" <%- tab === t[0] ? 'aria-current="page"' : '' %>><%= t[2] %></a>
  <% }) %>
  <% if (me.verification_status === 'approved') { %><a class="dash-nav-ext" href="<%= storeUrl(me) %>" target="_blank" rel="noopener">View storefront<svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true"><path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 01-1 1H5a1 1 0 01-1-1V7a1 1 0 011-1h5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg><span class="sr-only"> (opens in a new tab)</span></a><% } %>
</nav>
