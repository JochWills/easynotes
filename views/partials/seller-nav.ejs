<div class="dash-title">
  <h1><%= title %></h1>
  <% if (me.verification_status === 'approved' && tab !== 'notes') { %><a class="btn btn-sm" href="/seller/notes/new">Upload notes</a><% } %>
</div>
<nav class="dash-nav" aria-label="Seller">
  <% [['overview','/seller','Overview'],['profile','/seller/profile','Storefront'],['verification','/seller/verification','Verification'],['payouts','/seller/payouts','Payouts'],['sales','/seller/sales','Sales']].forEach(function (t) { %>
    <a href="<%= t[1] %>" <%- tab === t[0] ? 'aria-current="page"' : '' %>><%= t[2] %></a>
  <% }) %>
  <% if (me.verification_status === 'approved') { %><a href="<%= storeUrl(me) %>">View storefront</a><% } %>
</nav>
