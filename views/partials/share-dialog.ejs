<%# Share pop-up. Pass id, heading, intro, link, text (the message before the link), cardTitle, cardSub and cardIcon (html).
    Buttons with data-share-open="<id>" open it; data-share-url / -text / -title / -sub on the button swap in that item's details,
    so one pop-up serves a whole list (e.g. the seller's notes table). %>
<% var e = encodeURIComponent; var sLink = locals.link || ''; var sText = locals.text || ''; var sMsg = sText + '\n' + sLink; %>
<dialog class="modal share-modal" id="<%= id %>" aria-labelledby="<%= id %>-title" data-focus=".share-copy .btn" data-share-dialog>
  <div class="modal-head">
    <h2 id="<%= id %>-title"><%= heading %></h2>
    <button class="modal-x" type="button" data-dialog-close aria-label="Close"><svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg></button>
  </div>
  <p class="muted small"><%= intro %></p>

  <div class="share-card">
    <%- locals.cardIcon || '<span class="share-doc" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24"><path d="M6 3h8l4 4v14H6z M14 3v4h4 M9 12h6M9 16h4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round"/></svg></span>' %>
    <div>
      <strong data-share-card-title><%= locals.cardTitle || '' %></strong>
      <span data-share-card-sub><%= locals.cardSub || sLink.replace(/^https?:\/\//, '') %></span>
    </div>
  </div>

  <div class="share-copy">
    <input type="text" readonly value="<%= sLink %>" aria-label="Link" data-select-all data-share-input>
    <button class="btn" type="button" data-copy="<%= sLink %>" data-share-copy><svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><rect x="8" y="8" width="12" height="12" rx="2" fill="none" stroke="currentColor" stroke-width="2"/><path d="M16 8V6a2 2 0 00-2-2H6a2 2 0 00-2 2v8a2 2 0 002 2h2" fill="none" stroke="currentColor" stroke-width="2"/></svg><span data-copy-label>Copy link</span></button>
  </div>

  <%# data-share-href: {url}, {text} and {msg} (text + link) are filled in, encoded, when the pop-up opens for another item %>
  <ul class="share-grid" aria-label="Share on">
    <li><a href="https://wa.me/?text=<%= e(sMsg) %>" data-share-href="https://wa.me/?text={msg}" target="_blank" rel="noopener"><span class="share-ico share-wa" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24"><path d="M4 20l1.3-3.9A8 8 0 1112 20a8 8 0 01-3.9-1z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M9 8.5c0 3.5 3 6.5 6.5 6.5l1-1.6-2-1-1 .9c-1-.4-2-1.4-2.4-2.4l.9-1-1-2z" fill="currentColor"/></svg></span>WhatsApp</a></li>
    <li><a href="https://www.facebook.com/sharer/sharer.php?u=<%= e(sLink) %>" data-share-href="https://www.facebook.com/sharer/sharer.php?u={url}" target="_blank" rel="noopener"><span class="share-ico share-fb" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24"><path d="M13.5 21v-7.5h2.6l.4-3h-3V8.6c0-.9.3-1.5 1.5-1.5h1.6V4.4c-.3 0-1.2-.1-2.3-.1-2.3 0-3.8 1.4-3.8 3.9v2.3H8v3h2.5V21z" fill="currentColor"/></svg></span>Facebook</a></li>
    <li><a href="https://twitter.com/intent/tweet?text=<%= e(sText) %>&amp;url=<%= e(sLink) %>" data-share-href="https://twitter.com/intent/tweet?text={text}&url={url}" target="_blank" rel="noopener"><span class="share-ico share-x" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24"><path d="M4 4l16 16M20 4L4 20" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg></span>X</a></li>
    <li><a href="https://www.linkedin.com/sharing/share-offsite/?url=<%= e(sLink) %>" data-share-href="https://www.linkedin.com/sharing/share-offsite/?url={url}" target="_blank" rel="noopener"><span class="share-ico share-li" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24"><path d="M6 9.5V19M6 5.2v.1M10.5 19v-5.5c0-2.2 1.3-3.6 3.2-3.6s3 1.3 3 3.6V19M10.5 9.5V19" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg></span>LinkedIn</a></li>
    <li><a href="https://t.me/share/url?url=<%= e(sLink) %>&amp;text=<%= e(sText) %>" data-share-href="https://t.me/share/url?url={url}&text={text}" target="_blank" rel="noopener"><span class="share-ico share-tg" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24"><path d="M21 4L3 11l6 2 2 6 3-4 5 4z M9 13l8-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg></span>Telegram</a></li>
    <li><a href="mailto:?subject=<%= e(sText) %>&amp;body=<%= e(sMsg) %>" data-share-href="mailto:?subject={text}&body={msg}"><span class="share-ico share-mail" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2" fill="none" stroke="currentColor" stroke-width="2"/><path d="M3 7l9 6 9-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg></span>Email</a></li>
    <li hidden data-native-share-item><button type="button" data-native-share data-share-title="<%= locals.cardTitle || '' %> on EasyNotes" data-share-text="<%= sText %>" data-share-url="<%= sLink %>"><span class="share-ico share-more" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24"><circle cx="5" cy="12" r="1.8" fill="currentColor"/><circle cx="12" cy="12" r="1.8" fill="currentColor"/><circle cx="19" cy="12" r="1.8" fill="currentColor"/></svg></span>More</button></li>
  </ul>
</dialog>
