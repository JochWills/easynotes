<%# "Share my storefront" button and its pop-up. Pass seller (the storefront owner) and optionally btnClass. %>
<% var shareSeller = locals.seller; %>
<% var shareLink = (locals.baseUrl || 'https://easynotes.co.za') + storeUrl(shareSeller); %>
<% var shareText = 'Check out my study notes on EasyNotes'; %>
<% var shareMsg = shareText + ': ' + shareLink; %>
<% var e = encodeURIComponent; %>
<button class="btn <%= locals.btnClass || 'btn-ghost btn-sm' %>" type="button" data-dialog-open="share-dialog">
  <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><circle cx="18" cy="5" r="2.6" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="6" cy="12" r="2.6" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="18" cy="19" r="2.6" fill="none" stroke="currentColor" stroke-width="2"/><path d="M8.3 10.8l7.4-4.4M8.3 13.2l7.4 4.4" stroke="currentColor" stroke-width="2"/></svg>
  Share my storefront
</button>
<dialog class="modal share-modal" id="share-dialog" aria-labelledby="share-dialog-title" data-focus=".share-copy .btn">
  <div class="modal-head">
    <h2 id="share-dialog-title">Share your storefront</h2>
    <button class="modal-x" type="button" data-dialog-close aria-label="Close"><svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg></button>
  </div>
  <p class="muted small">Post it in study groups, class chats and on your socials. Anyone with the link can see and buy your notes.</p>

  <div class="share-card">
    <%- include('avatar', { person: shareSeller, cls: 'avatar-sm' }) %>
    <div>
      <strong><%= shareSeller.display_name %></strong>
      <span><%= shareLink.replace(/^https?:\/\//, '') %></span>
    </div>
  </div>

  <div class="share-copy">
    <input type="text" readonly value="<%= shareLink %>" aria-label="Your storefront link" data-select-all>
    <button class="btn" type="button" data-copy="<%= shareLink %>"><svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><rect x="8" y="8" width="12" height="12" rx="2" fill="none" stroke="currentColor" stroke-width="2"/><path d="M16 8V6a2 2 0 00-2-2H6a2 2 0 00-2 2v8a2 2 0 002 2h2" fill="none" stroke="currentColor" stroke-width="2"/></svg><span data-copy-label>Copy link</span></button>
  </div>

  <ul class="share-grid" aria-label="Share on">
    <li><a href="https://wa.me/?text=<%= e(shareMsg) %>" target="_blank" rel="noopener"><span class="share-ico share-wa" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24"><path d="M4 20l1.3-3.9A8 8 0 1112 20a8 8 0 01-3.9-1z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M9 8.5c0 3.5 3 6.5 6.5 6.5l1-1.6-2-1-1 .9c-1-.4-2-1.4-2.4-2.4l.9-1-1-2z" fill="currentColor"/></svg></span>WhatsApp</a></li>
    <li><a href="https://www.facebook.com/sharer/sharer.php?u=<%= e(shareLink) %>" target="_blank" rel="noopener"><span class="share-ico share-fb" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24"><path d="M13.5 21v-7.5h2.6l.4-3h-3V8.6c0-.9.3-1.5 1.5-1.5h1.6V4.4c-.3 0-1.2-.1-2.3-.1-2.3 0-3.8 1.4-3.8 3.9v2.3H8v3h2.5V21z" fill="currentColor"/></svg></span>Facebook</a></li>
    <li><a href="https://twitter.com/intent/tweet?text=<%= e(shareText) %>&amp;url=<%= e(shareLink) %>" target="_blank" rel="noopener"><span class="share-ico share-x" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24"><path d="M4 4l16 16M20 4L4 20" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg></span>X</a></li>
    <li><a href="https://www.linkedin.com/sharing/share-offsite/?url=<%= e(shareLink) %>" target="_blank" rel="noopener"><span class="share-ico share-li" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24"><path d="M6 9.5V19M6 5.2v.1M10.5 19v-5.5c0-2.2 1.3-3.6 3.2-3.6s3 1.3 3 3.6V19M10.5 9.5V19" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg></span>LinkedIn</a></li>
    <li><a href="https://t.me/share/url?url=<%= e(shareLink) %>&amp;text=<%= e(shareText) %>" target="_blank" rel="noopener"><span class="share-ico share-tg" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24"><path d="M21 4L3 11l6 2 2 6 3-4 5 4z M9 13l8-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg></span>Telegram</a></li>
    <li><a href="mailto:?subject=<%= e(shareText) %>&amp;body=<%= e(shareMsg) %>"><span class="share-ico share-mail" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2" fill="none" stroke="currentColor" stroke-width="2"/><path d="M3 7l9 6 9-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg></span>Email</a></li>
    <li hidden data-native-share-item><button type="button" data-native-share data-share-title="<%= shareSeller.display_name %> on EasyNotes" data-share-text="<%= shareText %>" data-share-url="<%= shareLink %>"><span class="share-ico share-more" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24"><circle cx="5" cy="12" r="1.8" fill="currentColor"/><circle cx="12" cy="12" r="1.8" fill="currentColor"/><circle cx="19" cy="12" r="1.8" fill="currentColor"/></svg></span>More</button></li>
  </ul>
</dialog>
