<% var cp = locals.cp || locals.currentPath || ''; %><!doctype html>
<html lang="en-ZA">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= locals.title ? title + ' | EasyNotes' : 'EasyNotes: study notes from verified academics' %></title>
  <meta name="description" content="<%= locals.description || 'PDF study notes for South African university modules and professional exams, written by verified academics. Pay once, download instantly.' %>">
  <% if (locals.noindex) { %><meta name="robots" content="noindex"><% } %>
  <meta property="og:site_name" content="EasyNotes">
  <meta property="og:title" content="<%= locals.title || 'EasyNotes' %>">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">
  <meta name="apple-mobile-web-app-title" content="EasyNotes">
  <meta name="theme-color" content="#ffffff">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&family=Caveat:wght@600&display=swap">
  <link rel="stylesheet" href="/css/style.css?v=82">
  <noscript><link rel="stylesheet" href="/css/noscript.css"></noscript>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header class="site-header">
  <div class="wrap">
    <a class="logo" href="/" aria-label="EasyNotes home">
      <svg width="28" height="32" viewBox="0 0 32 32" aria-hidden="true"><path d="M5 2h16l7 7v21H5z" fill="#fff" stroke="#0E1A3A" stroke-width="2.4" stroke-linejoin="round"/><path d="M21 2v7h7" fill="none" stroke="#0E1A3A" stroke-width="2.4" stroke-linejoin="round"/><rect x="8.5" y="13" width="15" height="6" rx="1" fill="#FFE27A"/><path d="M9 16h14M9 23.5h10" stroke="#0E1A3A" stroke-width="2.4" stroke-linecap="round"/></svg>
      <span>Easy<span class="logo-accent">Notes</span></span>
    </a>
    <% var cartCount = (locals.cartIds || []).length; %>
    <a class="cart-link<%= cp === '/cart' ? ' is-current' : '' %>" href="/cart" aria-label="Cart, <%= cartCount %> <%= cartCount === 1 ? 'item' : 'items' %>">
      <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 4h2.2l2.1 10.4a1.6 1.6 0 001.6 1.3h8.4a1.6 1.6 0 001.6-1.2L20.5 8H6.1" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/><circle cx="9.5" cy="19.5" r="1.4" fill="currentColor"/><circle cx="17" cy="19.5" r="1.4" fill="currentColor"/></svg>
      <% if (cartCount) { %><span class="cart-count" aria-hidden="true"><%= cartCount %></span><% } %>
    </a>
    <input type="checkbox" id="menu-toggle" class="menu-toggle sr-only" aria-controls="site-menu" aria-label="Menu">
    <label for="menu-toggle" class="menu-btn" aria-hidden="true"><span class="menu-bars"><i></i><i></i><i></i></span></label>
    <% var chev = '<svg class="nav-chev" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>'; %>
    <nav class="nav" id="site-menu" aria-label="Main">
      <div class="nav-links">
        <a href="/notes" <%- cp.startsWith('/notes') || cp.startsWith('/note/') ? 'aria-current="page"' : '' %>><span class="nav-ico" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24"><circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="2"/><path d="M16 16l4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></span>Browse notes<%- chev %></a>
        <a href="/how-it-works" <%- cp === '/how-it-works' ? 'aria-current="page"' : '' %>><span class="nav-ico" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5" fill="none" stroke="currentColor" stroke-width="2"/><path d="M12 11v5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><circle cx="12" cy="8" r="1.2" fill="currentColor"/></svg></span>How it works<%- chev %></a>
      </div>
      <div class="nav-actions">
        <% if (locals.user) { %>
          <% var isAdmin = user.role === 'admin'; var me = locals.me; var who = me ? (me.full_name || me.display_name) : (isAdmin ? 'Admin' : user.email); %>
          <% var accountLinks = isAdmin
               ? [['/admin', 'Admin dashboard', cp === '/admin'], ['/admin/sellers', 'Sellers', cp.startsWith('/admin/sellers')], ['/admin/orders', 'Orders', cp === '/admin/orders']]
               : [['/seller', 'Seller dashboard', cp === '/seller']].concat(me ? [[storeUrl(me), 'View my storefront', false]] : []).concat([['/seller/notes', 'Your notes', cp === '/seller/notes'], ['/seller/payouts', 'Payouts', cp === '/seller/payouts']]); %>
          <% var avatarEl = me && me.avatar_path ? '<img class="profile-avatar" src="' + avatarUrl(me) + '" alt="" width="36" height="36">' : '<span class="profile-avatar" aria-hidden="true">' + initials(me ? (me.full_name || me.display_name) : user.email) + '</span>'; %>
          <%# Desktop: avatar drop-down %>
          <details class="profile">
            <summary aria-label="Account menu">
              <%- avatarEl %>
              <svg class="profile-chevron" width="14" height="14" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </summary>
            <div class="profile-menu">
              <div class="profile-head">
                <strong><%= who %></strong>
                <span><%= user.email %></span>
              </div>
              <% accountLinks.forEach(function (l) { %><a href="<%= l[0] %>" <%- l[2] ? 'aria-current="page"' : '' %>><%= l[1] %></a><% }) %>
              <form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= locals.csrf %>"><button type="submit">Log out</button></form>
            </div>
          </details>
          <%# Phones and tablets: the same links, listed in the menu panel %>
          <div class="nav-account">
            <div class="nav-account-head">
              <%- avatarEl %>
              <div><strong><%= who %></strong><span><%= user.email %></span></div>
            </div>
            <% accountLinks.forEach(function (l) { %><a href="<%= l[0] %>" <%- l[2] ? 'aria-current="page"' : '' %>><%= l[1] %><%- chev %></a><% }) %>
            <form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= locals.csrf %>"><button class="nav-logout" type="submit">Log out</button></form>
          </div>
        <% } else { %>
          <a class="nav-login" href="/login" <%- cp === '/login' ? 'aria-current="page"' : '' %>>Log in</a>
          <a class="btn btn-hi btn-sm" href="/sell">Start selling</a>
        <% } %>
      </div>
    </nav>
  </div>
</header>
<label for="menu-toggle" class="menu-backdrop" aria-hidden="true"></label>
<% if (locals.flash) { %>
  <div class="toast toast-<%= flash.type %>" role="<%= flash.type === 'error' ? 'alert' : 'status' %>" data-toast>
    <span class="toast-icon" aria-hidden="true"><%= flash.type === 'error' ? '!' : flash.type === 'info' ? 'i' : '✓' %></span>
    <p><%= flash.msg %></p>
    <button class="toast-close" type="button" aria-label="Dismiss">×</button>
  </div>
<% } %>
<main id="main">
