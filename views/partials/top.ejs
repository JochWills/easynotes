<% var cp = locals.cp || locals.currentPath || ''; %><!doctype html>
<html lang="en-ZA">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= locals.title ? title + ' | EasyNotes' : 'EasyNotes: study notes from verified academics' %></title>
  <meta name="description" content="<%= locals.description || 'PDF study notes for South African university modules and professional exams, written by verified academics. Pay once, download instantly.' %>">
  <% if (locals.noindex) { %><meta name="robots" content="noindex"><% } %>
  <meta property="og:site_name" content="EasyNotes">
  <meta property="og:title" content="<%= locals.title || 'EasyNotes' %>">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">
  <meta name="apple-mobile-web-app-title" content="EasyNotes">
  <meta name="theme-color" content="#ffffff">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&family=Caveat:wght@600&display=swap">
  <link rel="stylesheet" href="/css/style.css?v=33">
  <noscript><link rel="stylesheet" href="/css/noscript.css"></noscript>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header class="site-header">
  <div class="wrap">
    <a class="logo" href="/" aria-label="EasyNotes home">
      <svg width="28" height="32" viewBox="0 0 32 32" aria-hidden="true"><path d="M5 2h16l7 7v21H5z" fill="#fff" stroke="#0E1A3A" stroke-width="2.4" stroke-linejoin="round"/><path d="M21 2v7h7" fill="none" stroke="#0E1A3A" stroke-width="2.4" stroke-linejoin="round"/><rect x="8.5" y="13" width="15" height="6" rx="1" fill="#FFE27A"/><path d="M9 16h14M9 23.5h10" stroke="#0E1A3A" stroke-width="2.4" stroke-linecap="round"/></svg>
      <span>Easy<span class="logo-accent">Notes</span></span>
    </a>
    <% var cartCount = (locals.cartIds || []).length; %>
    <a class="cart-link<%= cp === '/cart' ? ' is-current' : '' %>" href="/cart" aria-label="Cart, <%= cartCount %> <%= cartCount === 1 ? 'item' : 'items' %>">
      <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 4h2.2l2.1 10.4a1.6 1.6 0 001.6 1.3h8.4a1.6 1.6 0 001.6-1.2L20.5 8H6.1" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/><circle cx="9.5" cy="19.5" r="1.4" fill="currentColor"/><circle cx="17" cy="19.5" r="1.4" fill="currentColor"/></svg>
      <% if (cartCount) { %><span class="cart-count" aria-hidden="true"><%= cartCount %></span><% } %>
    </a>
    <input type="checkbox" id="menu-toggle" class="menu-toggle sr-only">
    <label for="menu-toggle" class="menu-btn"><span class="sr-only">Menu</span><svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></label>
    <nav class="nav" aria-label="Main">
      <div class="nav-links">
        <a href="/notes" <%- cp.startsWith('/notes') || cp.startsWith('/note/') ? 'aria-current="page"' : '' %>>Browse notes</a>
        <a href="/how-it-works" <%- cp === '/how-it-works' ? 'aria-current="page"' : '' %>>How it works</a>
      </div>
      <div class="nav-actions">
        <% if (locals.user) { %>
          <% var isAdmin = user.role === 'admin'; var me = locals.me; var who = me ? me.display_name : (isAdmin ? 'Admin' : user.email); %>
          <details class="profile">
            <summary aria-label="Account menu">
              <span class="profile-avatar" aria-hidden="true"><%= initials(me ? me.display_name : user.email) %></span>
              <span class="profile-name"><%= who %></span>
              <svg class="profile-chevron" width="14" height="14" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </summary>
            <div class="profile-menu">
              <div class="profile-head">
                <strong><%= who %></strong>
                <span><%= user.email %></span>
              </div>
              <% if (isAdmin) { %>
                <a href="/admin" <%- cp === '/admin' ? 'aria-current="page"' : '' %>>Admin dashboard</a>
                <a href="/admin/sellers" <%- cp.startsWith('/admin/sellers') ? 'aria-current="page"' : '' %>>Sellers</a>
                <a href="/admin/orders" <%- cp === '/admin/orders' ? 'aria-current="page"' : '' %>>Orders</a>
              <% } else { %>
                <a href="/seller" <%- cp === '/seller' ? 'aria-current="page"' : '' %>>Seller dashboard</a>
                <% if (me) { %><a href="<%= storeUrl(me) %>">View my storefront</a><% } %>
                <a href="/seller/sales" <%- cp === '/seller/sales' ? 'aria-current="page"' : '' %>>Sales</a>
                <a href="/seller/payouts" <%- cp === '/seller/payouts' ? 'aria-current="page"' : '' %>>Payouts</a>
              <% } %>
              <form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= locals.csrf %>"><button type="submit">Log out</button></form>
            </div>
          </details>
        <% } else { %>
          <a href="/login" <%- cp === '/login' ? 'aria-current="page"' : '' %>>Log in</a>
          <a class="btn btn-hi btn-sm" href="/sell">Start selling</a>
        <% } %>
      </div>
    </nav>
  </div>
</header>
<% if (locals.flash) { %>
  <div class="toast toast-<%= flash.type %>" role="<%= flash.type === 'error' ? 'alert' : 'status' %>" data-toast>
    <span class="toast-icon" aria-hidden="true"><%= flash.type === 'error' ? '!' : flash.type === 'info' ? 'i' : '✓' %></span>
    <p><%= flash.msg %></p>
    <button class="toast-close" type="button" aria-label="Dismiss">×</button>
  </div>
<% } %>
<main id="main">
