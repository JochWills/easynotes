<% var inCart = (locals.cartIds || []).indexOf(n.id) > -1; %>
<article class="note-card">
  <div class="note-top">
    <% if (n.module_code) { %><span class="tab"><%= n.module_code %></span><% } else { %><span class="tab tab-plain"><%= n.level %></span><% } %>
    <span class="pages"><svg width="13" height="15" viewBox="0 0 13 15" aria-hidden="true"><path d="M1.5 1h6.5l3.5 3.5v9.5h-10z M8 1v3.5h3.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg><%= n.page_count ? n.page_count + (n.page_count === 1 ? ' page' : ' pages') : 'PDF' %></span>
  </div>
  <h3><a href="<%= noteUrl(n) %>"><%= n.title %></a></h3>
  <p class="note-meta"><%= n.subject %><br><%= n.university %></p>
  <p class="note-by">By <%= n.sellers.display_name %></p>
  <div class="note-foot">
    <span class="price"><%= rand(n.price_cents) %></span>
    <% if (inCart) { %>
      <a class="card-cart is-in" href="/cart" data-note="<%= n.id %>">✓ In cart</a>
    <% } else { %>
      <form method="post" action="/cart/add/<%= n.id %>" data-cart-add data-note="<%= n.id %>">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <button class="card-cart" type="submit" aria-label="Add <%= n.title %> to cart"><svg width="17" height="17" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 4h2.2l2.1 10.4a1.6 1.6 0 001.6 1.3h8.4a1.6 1.6 0 001.6-1.2L20.5 8H6.1" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"/><circle cx="9.5" cy="19.5" r="1.4" fill="currentColor"/><circle cx="17" cy="19.5" r="1.4" fill="currentColor"/></svg>Add to cart</button>
      </form>
    <% } %>
  </div>
</article>
