<%- include('../partials/top', { noindex: true }) %>
<div class="wrap dash">
  <%- include('../partials/seller-nav') %>

  <% var verified = me.verification_status === 'approved'; var payouts = !!me.paystack_subaccount_code; %>
  <% if (!(verified && payouts && hasNotes)) { %>
    <h2 style="font-size:1.35rem">Get your storefront live</h2>
    <ol class="setup">
      <li class="<%= verified ? 'done' : '' %>">
        <span class="num"><%= verified ? '✓' : '1' %></span>
        <div><h3>Verify your degree</h3>
          <p><% if (me.verification_status === 'pending') { %>We’re reviewing your documents. This usually takes up to two working days.<% } else if (me.verification_status === 'rejected') { %>Not approved: <%= me.verification_note %><% } else if (verified) { %>Verified on <%= date(me.verified_at) %>.<% } else { %>Upload your degree certificate or transcript and your ID.<% } %></p>
        </div>
        <% if (['unsubmitted','rejected'].includes(me.verification_status)) { %><a class="btn btn-sm" href="/seller/verification"><%= me.verification_status === 'rejected' ? 'Resubmit' : 'Start' %></a><% } else { %><%- include('../partials/status-pill', { status: me.verification_status }) %><% } %>
      </li>
      <li class="<%= payouts ? 'done' : '' %>">
        <span class="num"><%= payouts ? '✓' : '2' %></span>
        <div><h3>Add your payout account</h3><p><%= payouts ? 'Paying into ' + me.bank_name + ' ••••' + me.account_number_last4 + '.' : 'Tell us where to pay your share of each sale.' %></p></div>
        <a class="btn btn-sm <%= payouts ? 'btn-ghost' : '' %>" href="/seller/payouts"><%= payouts ? 'Change' : 'Add' %></a>
      </li>
      <li class="<%= hasNotes ? 'done' : '' %>">
        <span class="num"><%= hasNotes ? '✓' : '3' %></span>
        <div><h3>Upload your first notes</h3><p><%= verified ? 'Add a PDF, price it and publish.' : 'Available once your degree is verified.' %></p></div>
        <% if (verified) { %><a class="btn btn-sm" href="/seller/notes/new">Upload</a><% } %>
      </li>
    </ol>
  <% } %>

  <% var periodLabel = periods.filter(function (p) { return p[0] === period; })[0][1]; %>
  <div class="period-row">
    <h2 class="period-title"><%= periodLabel %></h2>
    <form class="sort-by period-form" method="get" action="/seller" data-autosubmit>
      <button class="refresh-btn" type="submit" aria-label="Refresh figures" title="Refresh" data-refresh><svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 12a8 8 0 11-2.3-5.7M20 4v5h-5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
      <label for="period" class="sr-only">Time period</label>
      <select id="period" name="period">
        <% periods.forEach(function (p) { %><option value="<%= p[0] %>" <%= p[0] === period ? 'selected' : '' %>><%= p[1] %></option><% }) %>
      </select>
    </form>
  </div>

  <div class="stats">
    <div class="stat"><b><%= rand(earnings) %></b><span>Your earnings</span></div>
    <div class="stat"><b><%= sales %></b><span><%= sales === 1 ? 'Sale' : 'Sales' %></span></div>
    <div class="stat"><b><%= published %></b><span>Published notes</span></div>
  </div>

  <h2 style="font-size:1.35rem">Sales</h2>
  <% if (orders.length) { %>
    <div class="table-wrap">
      <table class="data">
        <thead><tr><th>Date</th><th>Notes</th><th>Buyer</th><th class="num">Price</th><th class="num">You earn</th></tr></thead>
        <tbody>
          <% orders.forEach(function (o) { %>
            <tr>
              <td><%= date(o.paid_at) %></td>
              <td><%= o.notes ? o.notes.title : '' %></td>
              <td><%= maskEmail(o.email) %></td>
              <td class="num"><%= rand(o.amount_cents) %></td>
              <td class="num"><strong><%= rand(o.seller_earnings_cents) %></strong></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <p class="fineprint"><%= orders.length === 200 ? 'Showing your latest 200 sales. ' : '' %>Earnings are after the <%= feePercent %>% EasyNotes fee<%= feeBearer === 'subaccount' ? ' and before the card processing fee' : ', which already includes payment processing' %>. They’re paid into your bank account.</p>
  <% } else if (period !== 'all' && sales === 0) { %>
    <div class="empty empty-sm"><h3>No sales in this period</h3><p>Try a longer period, or share your storefront link with study groups to get more sales.</p><a class="btn btn-ghost" href="/seller">Show all time</a></div>
  <% } else { %>
    <div class="empty"><h3>No sales yet</h3><p>Sales show up here as soon as a student pays. Sharing your storefront link with study groups is the fastest way to your first sale.</p><% if (me.verification_status === 'approved') { %><a class="btn btn-ghost" href="<%= storeUrl(me) %>">Open your storefront</a><% } %></div>
  <% } %>
</div>
<%- include('../partials/bottom') %>
