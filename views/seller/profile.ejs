<%- include('../partials/top', { noindex: true }) %>
<div class="wrap dash">
  <%- include('../partials/seller-nav') %>
  <div class="dash-grid">
    <div>
    <form class="form card" method="post" action="/seller/profile" enctype="multipart/form-data" novalidate data-unsaved>
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="field <%= errors.avatar ? 'has-error' : '' %>">
        <span class="label" id="p-avatar-label">Profile picture</span>
        <div class="avatar-edit" data-avatar-edit data-initials="<%= initials(me.display_name) %>">
          <span data-avatar-slot><%- include('../partials/avatar', { person: me, cls: 'avatar-md' }) %></span>
          <div class="avatar-edit-body">
            <div class="avatar-edit-actions">
              <label class="btn btn-ghost btn-sm" for="p-avatar"><%= me.avatar_path ? 'Change picture' : 'Upload a picture' %></label>
              <input id="p-avatar" class="sr-only" type="file" name="avatar" accept="image/jpeg,image/png,image/webp" aria-labelledby="p-avatar-label" data-max-mb="8">
              <% if (me.avatar_path) { %><label class="check small"><input type="checkbox" name="remove_avatar"> <span>Remove picture</span></label><% } %>
            </div>
            <span class="hint">A clear photo of your face builds trust with students. JPG, PNG or WebP, up to 8 MB. We crop it to a square.</span>
          </div>
        </div>
        <%- include('../partials/field-error', { name: 'avatar' }) %>
      </div>
      <div class="field <%= errors.full_name ? 'has-error' : '' %>">
        <label for="p-full">Your full name <span class="muted">(private)</span></label>
        <input id="p-full" type="text" name="full_name" value="<%= values.full_name || '' %>" required maxlength="80" autocomplete="name">
        <span class="hint">Not shown to students. Used for your account, emails and payouts.</span>
        <%- include('../partials/field-error', { name: 'full_name' }) %>
      </div>
      <div class="field <%= errors.display_name ? 'has-error' : '' %>">
        <label for="p-name">Storefront name</label>
        <input id="p-name" type="text" name="display_name" value="<%= values.display_name %>" required maxlength="80">
        <%- include('../partials/field-error', { name: 'display_name' }) %>
      </div>
      <div class="field <%= errors.slug ? 'has-error' : '' %>">
        <label for="p-slug">Storefront link</label>
        <% var shareUrl = (locals.baseUrl || 'https://easynotes.co.za') + storeUrl(me); %>
        <div class="prefix prefix-copy"><span><span class="prefix-domain"><%= (locals.baseUrl || 'https://easynotes.co.za').replace(/^https?:\/\//, '') %></span>/</span><input id="p-slug" type="text" name="slug" value="<%= values.slug %>" maxlength="40" spellcheck="false" data-saved-slug="<%= me.slug %>"><% if (me.verification_status === 'approved') { %><button class="copy-in" type="button" data-copy="<%= shareUrl %>" aria-label="Copy your storefront link"><svg width="17" height="17" viewBox="0 0 24 24" aria-hidden="true"><rect x="8" y="8" width="12" height="12" rx="2" fill="none" stroke="currentColor" stroke-width="2"/><path d="M16 8V6a2 2 0 00-2-2H6a2 2 0 00-2 2v8a2 2 0 002 2h2" fill="none" stroke="currentColor" stroke-width="2"/></svg><span data-copy-label>Copy</span></button><% } %></div>
        <span class="hint">Letters, numbers and dashes. Changing it breaks links you’ve already shared.</span>
        <%- include('../partials/field-error', { name: 'slug' }) %>
      </div>
      <div class="field <%= errors.headline ? 'has-error' : '' %>">
        <label for="p-headline">Headline</label>
        <input id="p-headline" type="text" name="headline" value="<%= values.headline || '' %>" maxlength="120" placeholder="e.g. CA(SA). Accounting notes for first and second years.">
        <%- include('../partials/field-error', { name: 'headline' }) %>
      </div>
      <div class="field <%= errors.bio ? 'has-error' : '' %>">
        <label for="p-bio">About you</label>
        <textarea id="p-bio" name="bio" maxlength="1500" placeholder="What you studied, how you got your marks, how your notes are structured."><%= values.bio || '' %></textarea>
        <span class="hint">Students read this before buying. Mention marks or distinctions if you have them.</span>
        <%- include('../partials/field-error', { name: 'bio' }) %>
      </div>
      <div class="form-actions"><button class="btn" type="submit">Save storefront</button></div>
    </form>
    <section class="danger-zone" aria-labelledby="danger-h">
      <h2 id="danger-h">Delete your account</h2>
      <p>Permanently delete your storefront, documents and login. Students who bought your notes keep their downloads.</p>
      <a class="btn btn-ghost btn-danger-ghost btn-sm" href="/seller/account/delete">Delete account</a>
    </section>
    </div>
    <div class="sticky-preview">
      <h2 style="font-size:1.2rem">What students see</h2>
      <div class="author" style="margin-top:12px">
        <span data-avatar-slot><%- include('../partials/avatar', { person: me, name: values.display_name }) %></span>
        <div>
          <h3><%= values.display_name %></h3>
          <% if (me.verification_status === 'approved') { %><%- include('../partials/verified') %><% } %>
          <p><%= me.degree || 'Your degree' %>, <%= me.university || 'your institution' %></p>
          <% if (values.headline) { %><p class="muted"><%= values.headline %></p><% } %>
        </div>
      </div>
      <p class="fineprint">Your degree and institution come from verification and can’t be edited here.</p>
    </div>
  </div>
</div>
<%- include('../partials/bottom') %>
