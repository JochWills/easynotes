<%- include('../partials/top', { noindex: true }) %>
<div class="wrap dash">
  <%- include('../partials/seller-nav') %>
  <% var editing = !!note; %>
  <% if (errors.files) { %><div class="alert alert-error" role="alert"><%= errors.files %></div><% } %>
  <form class="form" method="post" action="<%= editing ? '/seller/notes/' + note.id : '/seller/notes' %>" enctype="multipart/form-data" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="dash-grid">
      <div class="form card">
        <div class="field <%= errors.title ? 'has-error' : '' %>">
          <label for="n-title">Title</label>
          <input id="n-title" type="text" name="title" value="<%= values.title || '' %>" maxlength="120" required placeholder="e.g. Financial Accounting I: complete exam summary">
          <%- include('../partials/field-error', { name: 'title' }) %>
        </div>
        <div class="row-2">
          <div class="field <%= errors.subject ? 'has-error' : '' %>">
            <label for="n-subject">Subject</label>
            <input id="n-subject" type="text" name="subject" value="<%= values.subject || '' %>" maxlength="80" required placeholder="e.g. Accounting">
            <%- include('../partials/field-error', { name: 'subject' }) %>
          </div>
          <div class="field <%= errors.module_code ? 'has-error' : '' %>">
            <label for="n-code">Module code <span class="muted">(optional)</span></label>
            <input id="n-code" type="text" name="module_code" value="<%= values.module_code || '' %>" maxlength="20" placeholder="e.g. ACC1006F" spellcheck="false">
            <%- include('../partials/field-error', { name: 'module_code' }) %>
          </div>
        </div>
        <div class="row-2">
          <div class="field <%= errors.university ? 'has-error' : '' %>">
            <label for="n-uni">Institution</label>
            <select id="n-uni" name="university" required>
              <option value="">Choose</option>
              <% institutions.forEach(function (u) { %><option <%= values.university === u ? 'selected' : '' %>><%= u %></option><% }) %>
            </select>
            <%- include('../partials/field-error', { name: 'university' }) %>
          </div>
          <div class="field <%= errors.level ? 'has-error' : '' %>">
            <label for="n-level">Level</label>
            <select id="n-level" name="level" required>
              <option value="">Choose</option>
              <% levels.forEach(function (l) { %><option <%= values.level === l ? 'selected' : '' %>><%= l %></option><% }) %>
            </select>
            <%- include('../partials/field-error', { name: 'level' }) %>
          </div>
        </div>
        <div class="field <%= errors.description ? 'has-error' : '' %>">
          <label for="n-desc">What’s covered</label>
          <textarea id="n-desc" name="description" maxlength="4000" required placeholder="Which chapters or topics, how the notes are laid out, which year you wrote them, and what makes them useful."><%= values.description || '' %></textarea>
          <span class="hint">Specific beats general. List topics so students can match them to their course outline.</span>
          <%- include('../partials/field-error', { name: 'description' }) %>
        </div>
      </div>

      <div class="form">
        <div class="card form">
          <div class="field <%= errors.price ? 'has-error' : '' %>">
            <label for="n-price">Price</label>
            <div class="prefix"><span>R</span><input id="n-price" type="text" inputmode="decimal" name="price" value="<%= values.price || '' %>" required data-price data-fee="<%= feePercent %>"></div>
            <span class="hint">R10 to R2,000. You receive <strong data-earn>R0.00</strong> per sale after the <%= feePercent %>% EasyNotes fee.</span>
            <%- include('../partials/field-error', { name: 'price' }) %>
          </div>
          <div class="field <%= errors.pdf ? 'has-error' : '' %>">
            <label for="n-pdf"><%= editing ? 'Replace PDF' : 'Notes PDF' %></label>
            <input id="n-pdf" type="file" name="pdf" accept="application/pdf" <%= editing ? '' : 'required' %>>
            <span class="hint"><%= editing ? 'Leave empty to keep the current file' + (note.page_count ? ' (' + note.page_count + ' pages)' : '') + '. Past buyers get the new version.' : 'PDF only, up to 50 MB. This is what buyers download.' %> Students see a preview of the first 2½ pages on your listing (less for short notes).</span>
            <%- include('../partials/field-error', { name: 'pdf' }) %>
          </div>
          <div class="field <%= errors.own_work ? 'has-error' : '' %>"><label class="check"><input type="checkbox" name="own_work"> <span>These notes are my own work and contain no copied textbooks, slides or past papers.</span></label><%- include('../partials/field-error', { name: 'own_work' }) %></div>
        </div>
        <div class="form-actions">
          <% if (editing) { %>
            <button class="btn" type="submit">Save changes</button>
          <% } else { %>
            <button class="btn btn-hi" type="submit" name="publish" value="1">Upload and publish</button>
            <button class="btn btn-ghost" type="submit" name="publish" value="0">Save as draft</button>
          <% } %>
          <a href="/seller">Cancel</a>
          <% if (editing) { %><a class="delete-link" href="/seller/notes/<%= note.id %>/delete">Delete these notes</a><% } %>
        </div>
      </div>
    </div>
  </form>
</div>
<%- include('../partials/bottom') %>
