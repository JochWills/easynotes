<%- include('partials/top', { noindex: true }) %>
<% var many = orders.length > 1; %>
<div class="wrap narrow doc">
  <% if (status === 'paid') { %>
    <dialog class="download" data-autoshow aria-labelledby="dl-title">
      <button class="dialog-close" type="button" data-close aria-label="Close">×</button>
      <div class="dialog-body">
        <h2 id="dl-title">Payment received</h2>
        <% if (many) { %>
          <p>Your <strong><%= orders.length %> sets of notes</strong> are ready to download.</p>
        <% } else { %>
          <p><strong><%= orders[0].notes.title %></strong> is ready to download.</p>
        <% } %>
        <div class="ref-box">
          <div class="ref-row"><span>Payment reference</span><span class="ref"><%= paymentRef %></span></div>
          <div class="ref-row"><span>Email</span><span class="ref-email"><%= email %></span></div>
        </div>
        <% if (many) { %>
          <%- include('partials/library-list') %>
        <% } else { %>
          <form method="post" action="/download" data-download>
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <input type="hidden" name="email" value="<%= email %>">
            <input type="hidden" name="reference" value="<%= orders[0].reference %>">
            <div class="form-actions">
              <button class="btn btn-hi" type="submit" autofocus>Download PDF</button>
              <button class="btn btn-ghost btn-sm" type="button" data-copy="<%= paymentRef %>">Copy reference</button>
            </div>
          </form>
        <% } %>
        <p class="small"><% if (locals.emailEnabled) { %>We’ve also emailed a download link to <%= email %>. <% } %>Save your reference. With your email, it lets you download your notes again from any device, up to <%= maxDownloads %> times each.</p>
      </div>
    </dialog>

    <h1>Your notes are ready</h1>
    <p>Thanks for your purchase. If the download window closed, use the <%= many ? 'buttons' : 'button' %> below.</p>
    <div class="card">
      <div class="ref-box">
        <div class="ref-row"><span>Payment reference</span><span class="ref"><%= paymentRef %></span></div>
        <div class="ref-row"><span>Email</span><span class="ref-email"><%= email %></span></div>
      </div>
      <%- include('partials/library-list') %>
      <p class="fineprint"><% if (locals.emailEnabled) { %>We’ve emailed you a link to all your notes. <% } %>To download again later, go to <a href="/download">Re-download</a> and enter your email and reference.</p>
    </div>
  <% } else if (status === 'failed') { %>
    <h1>Payment didn’t go through</h1>
    <p>The payment didn’t go through, so you haven’t been charged for <% if (many) { %>your <strong><%= orders.length %> sets of notes</strong><% } else { %><strong><%= orders[0].notes.title %></strong><% } %>.</p>
    <a class="btn" href="<%= many ? '/cart' : noteUrl({ id: orders[0].note_id, slug: orders[0].notes.slug }) + '#buy' %>">Try again</a>
  <% } else { %>
    <h1>We’re waiting for your payment to be confirmed</h1>
    <p>Your payment of <strong><%= rand(total) %></strong> hasn’t been confirmed yet. This usually takes a few seconds. EFT payments can take longer.</p>
    <div class="ref-box">
      <div class="ref-row"><span>Payment reference</span><span class="ref"><%= paymentRef %></span></div>
    </div>
    <div class="form-actions">
      <a class="btn" href="/checkout/callback?reference=<%= encodeURIComponent(paymentRef) %>">Check again</a>
      <a class="btn btn-ghost" href="/download<%= qs({ email: email, reference: paymentRef }) %>">Download later</a>
    </div>
  <% } %>
</div>
<%- include('partials/bottom') %>
